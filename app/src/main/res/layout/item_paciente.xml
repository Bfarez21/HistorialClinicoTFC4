<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@drawable/card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardMaxElevation="8dp"
    android:id="@+id/cardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0e81d0"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iconPac"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="25dp"
            android:src="@drawable/usersinfondo"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cedulaPac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cedula"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/nombrePac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/apellidoPac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apellido"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:layout_marginBottom="4dp"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/profesionPac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profesion"
                android:textSize="16sp"
                android:textColor="@android:color/white"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>